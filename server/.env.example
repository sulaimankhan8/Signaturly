# ==============================================================================
# SIGNATURLY PRO BACKEND - PRODUCTION & TEMPLATE ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=production
APP_NAME="Signaturly Pro"
APP_URL=https://app.yourdomain.com

# Comma-separated allowed frontend & admin origins:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://app.yourdomain.com,https://admin.yourdomain.com,https://signaturly.vercel.app,https://signaturly-admin.vercel.app

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/signaturly_prod?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_64_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_64_characters
ADMIN_SECRET_KEY=signaturly-superadmin-secret

# Storage Provider ('local' or 'gcs')
STORAGE_PROVIDER=local
# GCP_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=signaturly-prod-vault-storage
# GCS_SIGNED_URL_EXPIRES=900

# Mail Relay (Nodemailer / Gmail SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Signaturly Pro Vault <noreply@yourdomain.com>"
