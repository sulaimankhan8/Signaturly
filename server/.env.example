# ==============================================================================
# PACTDOC BACKEND - PRODUCTION & TEMPLATE ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=production
APP_NAME="PactDoc"
APP_URL=https://app.yourdomain.com

# Comma-separated allowed frontend & admin origins:
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://app.yourdomain.com,https://admin.yourdomain.com,https://app.pactdoc.com,https://admin.pactdoc.com

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pactdoc_prod?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Admin portal: a key typed at login, and a separate secret that signs admin sessions.
# Generate each with: openssl rand -hex 32. The server refuses to start with missing or placeholder values.
ADMIN_SECRET_KEY=
ADMIN_JWT_SECRET=

# Audit log: key for the hash chain. Generate with: openssl rand -hex 32. Never change it once in use.
# AUDIT_HMAC_KEY=

# Certificate that seals completed PDFs. Create with: npm run seal:generate
# Outside production a development certificate is generated automatically.
# SEAL_P12_BASE64=
# SEAL_P12_PASSWORD=

# Shared secret the scheduler sends in the X-Internal-Secret header when it calls
#   POST /api/internal/jobs/run          (every minute)
#   POST /api/internal/cron/reminders    (every 4 hours)
#   POST /api/internal/cron/expirations  (hourly)
#   POST /api/internal/cron/subscriptions (hourly)
# INTERNAL_JOB_SECRET=

# Signed file links and signing links
# FILE_URL_SECRET=            # defaults to JWT_ACCESS_SECRET
# FILE_URL_TTL_SECONDS=3600
# SIGNING_LINK_TTL_DAYS=30

# Billing. Off by default in production until payments are fully wired.
# BILLING_ENABLED=false
# Razorpay: with both set, plans, extra documents and wallet credit are sold through Razorpay orders
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# The passphrase typed when adding the webhook in Razorpay (URL: <API>/api/webhooks/razorpay,
# event: payment.captured). Without it a paid order is never granted.
# RAZORPAY_WEBHOOK_SECRET=

# The seller's details printed on invoices. Until SELLER_GSTIN is set, customers get receipts
# with no tax shown, because a business not registered for GST cannot issue a tax invoice.
# SELLER_LEGAL_NAME=
# SELLER_ADDRESS=
# SELLER_GSTIN=
# SELLER_STATE_CODE=          # two digits; taken from the GST number when left empty

# Take the price of each SMS and WhatsApp message from the sender's wallet (on by default in production)
# USAGE_CHARGING_ENABLED=true

# Stripe is not used: nothing in the app starts a Stripe payment. Leave these unset.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SMS and WhatsApp delivery. Off by default in production: only development providers exist so far.
# MESSAGING_ENABLED=false
# MESSAGING_PROVIDER=console

# Ready-made templates that no lawyer has reviewed are hidden in production.
# Set to true only to preview them on a production-mode server; never for real customers.
# TEMPLATES_ALLOW_UNREVIEWED=false

# Number of proxies in front of the API (1 on Cloud Run)
# TRUST_PROXY=1

# Storage Provider ('local' or 'gcs')
STORAGE_PROVIDER=local
# GCP_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=pactdoc-documents
# GCS_SIGNED_URL_EXPIRES=900

# Mail Relay (Nodemailer / Gmail SMTP / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="PactDoc <noreply@yourdomain.com>"

# --- Teams, API and stronger signatures (phases 5 and 6) ---
# Key for secrets stored encrypted: two-step sign-in seeds and single sign-on client secrets.
# Set it once and never change it: changing it makes everything encrypted with it unreadable.
# Without it the audit key is used.
DATA_ENCRYPTION_KEY=
# Where this API is reached from outside. Identity providers send people back to it after single sign-on.
API_URL=http://localhost:5000
# Aadhaar eSign provider. Leave empty in production until a licensed provider is connected.
# Outside production it defaults to "fake", a stand-in with no legal effect.
ESIGN_PROVIDER=
ESIGN_CALLBACK_SECRET=
